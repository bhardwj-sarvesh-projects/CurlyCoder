{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/CODELEAN-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading CODELEAN mode..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/CODELEAN-subagent.js\"",
            "timeout": 5,
            "statusMessage": "Loading CODELEAN mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/CODELEAN-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking CODELEAN mode..."
          }
        ]
      }
    ]
  }
}
